    "css",
    "subgrid",
    "corner-shape",
    "squircle",
    "scroll-state",
    "container-queries",
    "interpolate-size",
    "gap-decorations",
    "reading-flow",
    "tailwind",
    "interop-2027",
    "css-functions"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/profullstack/modern-css.git"
  },
  "homepage": "https://github.com/profullstack/modern-css#readme",
  "bugs": {
    "url": "https://github.com/profullstack/modern-css/issues"
  },
  "license": "MIT",
  "author": "Profullstack, Inc.",
  "style": "./modern.css",
  "exports": {
    ".": "./modern.css",
    "./modern.css": "./modern.css",
    "./functions.css": "./functions.css",
    "./tailwind.css": "./tailwind.css",
    "./package.json": "./package.json"
  },
  "files": [
    "modern.css",
    "functions.css",
    "tailwind.css",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test"
  }

{
  "name": "@profullstack/modern-css",
  "version": "0.2.0",
  "type": "module",
  "description": "Subgrid cards, squircle corners, stuck headers, grid gap rules, height:auto accordions and reading-flow as opt-in classes, plus custom @function helpers (--alpha, --tint, --shade, --inner-radius, --fluid). Progressive enhancement only, in the components layer, for plain CSS and Tailwind 4.",
